{
  "$schema-note": "Design tokens: the single source for colours, type, spacing and motion. scripts/design.mjs turns this into mockups/tokens.css (and later app/theme/tokens.ts). Units: dp for sizes, ms for durations. Edit here, then run `node scripts/design.mjs tokens`.",
  "version": 1,
  "reference-screen": { "widthDp": 915, "heightDp": 412, "minWidthDp": 732, "minHeightDp": 360, "orientation": "landscape" },

  "themes": {
    "night": {
      "bg": "#080B10",
      "bgRaised": "#0E131A",
      "bgGlow": "#12304A",
      "glassFill": "rgba(160,196,255,0.055)",
      "glassFillStrong": "rgba(160,196,255,0.10)",
      "glassEdge": "rgba(196,222,255,0.14)",
      "glassHighlight": "rgba(255,255,255,0.09)",
      "divider": "rgba(196,222,255,0.08)",
      "scrim": "rgba(4,6,10,0.72)",
      "textPrimary": "#EDF2F7",
      "textSecondary": "#9AA8B8",
      "textTertiary": "#5E6B7A",
      "textDisabled": "#3B4552",
      "textOnAccent": "#061018",
      "accent": "#7CC8FF",
      "accentMuted": "rgba(124,200,255,0.16)",
      "focus": "#B9E0FF"
    },
    "sun": {
      "bg": "#F4F6F8",
      "bgRaised": "#FFFFFF",
      "bgGlow": "#FFFFFF",
      "glassFill": "#FFFFFF",
      "glassFillStrong": "#E6EBF0",
      "glassEdge": "#1B2430",
      "glassHighlight": "rgba(0,0,0,0)",
      "divider": "#C9D1DA",
      "scrim": "rgba(10,14,20,0.55)",
      "textPrimary": "#05080C",
      "textSecondary": "#2E3A48",
      "textTertiary": "#5A6776",
      "textDisabled": "#A4AEB9",
      "textOnAccent": "#FFFFFF",
      "accent": "#0057B8",
      "accentMuted": "rgba(0,87,184,0.12)",
      "focus": "#0057B8"
    }
  },

  "metric": {
    "night": {
      "speed": "#EDF2F7",
      "drive": "#FFB23F",
      "regen": "#3FE0B0",
      "voltage": "#A99BFF",
      "battery": "#3FE0B0",
      "temp": "#FF8A5B",
      "duty": "#7CC8FF",
      "gps": "#7CC8FF"
    },
    "sun": {
      "speed": "#05080C",
      "drive": "#B25E00",
      "regen": "#007A55",
      "voltage": "#4B2FD6",
      "battery": "#007A55",
      "temp": "#C23B0A",
      "duty": "#0057B8",
      "gps": "#0057B8"
    }
  },

  "state": {
    "night": { "ok": "#3FE0B0", "info": "#7CC8FF", "warn": "#FFC53D", "crit": "#FF4D5E", "stale": "#5E6B7A" },
    "sun": { "ok": "#007A55", "info": "#0057B8", "warn": "#9A6200", "crit": "#C4001A", "stale": "#7A8592" }
  },

  "zone-note": "Zones colour a value against its limits. Temperature limits come from the controller's derating start/end; battery from SoC; duty from 0.85/0.95. Order: cold/low → ok → warn → crit.",
  "zones": {
    "temperature": { "ok": "state.ok", "warn": "state.warn (from derating start − 10 °C)", "crit": "state.crit (from derating start)" },
    "soc": { "crit": "< 10 %", "warn": "< 20 %", "ok": ">= 20 %" },
    "duty": { "ok": "< 0.85", "warn": "0.85-0.95", "crit": ">= 0.95" }
  },

  "font": {
    "display": { "family": "Barlow Semi Condensed", "fallback": "Roboto Condensed, sans-serif", "weights": [500, 600, 700], "use": "every live number, gauge numerals, timers" },
    "ui": { "family": "IBM Plex Sans", "fallback": "Roboto, sans-serif", "weights": [400, 500, 600], "use": "labels, lists, buttons, body" },
    "mono": { "family": "IBM Plex Mono", "fallback": "monospace", "weights": [400, 500], "use": "IDs, firmware, hex, dev info" },
    "license": "All three are SIL Open Font License; ship via @expo-google-fonts packages.",
    "numerals": "tabular-nums on every live value so digits don't jitter"
  },

  "type-note": "size in dp, lineHeight as a multiple, tracking (letter-spacing) in dp.",
  "type": {
    "hero":    { "font": "display", "size": 112, "weight": 600, "lineHeight": 0.9, "tracking": -2 },
    "numXL":   { "font": "display", "size": 64,  "weight": 600, "lineHeight": 0.95, "tracking": -1 },
    "numL":    { "font": "display", "size": 40,  "weight": 600, "lineHeight": 1.0, "tracking": -0.5 },
    "numM":    { "font": "display", "size": 28,  "weight": 600, "lineHeight": 1.0, "tracking": 0 },
    "numS":    { "font": "display", "size": 20,  "weight": 500, "lineHeight": 1.1, "tracking": 0 },
    "unit":    { "font": "ui",      "size": 13,  "weight": 500, "lineHeight": 1.2, "tracking": 0.2 },
    "title":   { "font": "ui",      "size": 20,  "weight": 600, "lineHeight": 1.25, "tracking": 0 },
    "heading": { "font": "ui",      "size": 15,  "weight": 600, "lineHeight": 1.3, "tracking": 0 },
    "body":    { "font": "ui",      "size": 14,  "weight": 400, "lineHeight": 1.45, "tracking": 0 },
    "label":   { "font": "ui",      "size": 11,  "weight": 600, "lineHeight": 1.2, "tracking": 1.1, "case": "upper" },
    "caption": { "font": "ui",      "size": 12,  "weight": 400, "lineHeight": 1.35, "tracking": 0.1 },
    "mono":    { "font": "mono",    "size": 12,  "weight": 400, "lineHeight": 1.35, "tracking": 0 }
  },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40 },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 20, "pill": 999 },
  "stroke": { "hairline": 1, "edge": 1, "gaugeTrack": 10, "gaugeValue": 10, "chartLine": 2 },

  "grid": {
    "columns": 12,
    "rows": 6,
    "gap": 8,
    "padding": 10,
    "statusBarHeight": 30,
    "note": "Ride-mode widgets snap to this cell grid. A widget is {x, y, w, h} in cells. Minimum widget 2x1. Pages swipe horizontally."
  },

  "touch": { "minTarget": 48, "rideMinTarget": 56, "note": "Ride mode uses the bigger target: gloves and vibration." },

  "ride-legibility": {
    "minLiveValueSize": 28,
    "minLabelSize": 11,
    "minContrastRatio": 7,
    "note": "Values read at arm's length on a handlebar. Night theme text on glass must pass 7:1; sun theme is the outdoor high-contrast fallback."
  },

  "glass": {
    "tiers": {
      "full":   { "backdropBlur": 24, "use": "transient overlays only: sheets, menus, edit toolbar" },
      "static": { "backdropBlur": 0, "bakedBackground": true, "use": "widgets: page background is pre-blurred once, edges and highlight are drawn" },
      "flat":   { "backdropBlur": 0, "bakedBackground": false, "use": "power-save, thermal throttling, sun theme" }
    },
    "edge": "1dp inner stroke glassEdge + 1dp top highlight glassHighlight",
    "note": "Never put real backdrop blur over live-animating content."
  },

  "motion": {
    "valueTween": 90,
    "gaugeSpring": { "damping": 22, "stiffness": 260 },
    "fast": 120,
    "base": 200,
    "sheet": 280,
    "bannerIn": 180,
    "critPulse": 900,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "reducedMotion": "values jump without tween; no pulse; banners appear without slide"
  },

  "icons": {
    "set": "Lucide (ISC). App: lucide-react-native. Mockups: mockups/icons.js sprite with the same names.",
    "size": { "sm": 16, "md": 20, "lg": 24 },
    "strokeWidth": 2
  }
}
